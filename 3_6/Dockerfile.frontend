FROM ubuntu:22.04
WORKDIR /usr/src/app
ENV REACT_APP_BACKEND_URL=http://localhost:8080
COPY code/example-frontend .
RUN apt-get update && apt-get install -y curl && curl -sL https://deb.nodesource.com/setup_16.x | bash && apt-get install -y nodejs && npm install && npm run build && npm install -g serve && rm -rf src && useradd -m appuser && chown -R appuser:appuser /usr/src/app && apt-get clean && rm -rf /var/lib/apt/lists/*
USER appuser
EXPOSE 5001
CMD ["serve", "-s", "-l", "5001", "build"]
