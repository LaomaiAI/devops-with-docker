FROM node:16-alpine
WORKDIR /usr/src/app
ENV REACT_APP_BACKEND_URL=http://localhost:8080
COPY code/example-frontend .
RUN npm install && npm run build && npm install -g serve && adduser -D appuser && chown -R appuser:appuser /usr/src/app
USER appuser
EXPOSE 5001
CMD ["serve", "-s", "-l", "5001", "build"]
